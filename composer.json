{
    "name": "edram/laravel-temp-workspace",
    "description": "Temporary workspaces backed by Laravel Storage",
    "keywords": [
        "laravel",
        "temporary-workspace",
        "laravel-storage"
    ],
    "homepage": "https://github.com/edram/laravel-temp-workspace",
    "license": "MIT",
    "authors": [
        {
            "name": "edram",
            "email": "edram@qq.com",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^8.3",
        "illuminate/console": "^12.45 || ^13.0",
        "illuminate/contracts": "^12.45 || ^13.0",
        "illuminate/filesystem": "^12.45 || ^13.0",
        "illuminate/queue": "^12.45 || ^13.0",
        "illuminate/support": "^12.45 || ^13.0",
        "league/flysystem-path-prefixing": "^3.0"
    },
    "require-dev": {
        "larastan/larastan": "^3.0",
        "laravel/pint": "^1.24",
        "orchestra/testbench": "^10.0 || ^11.0",
        "pestphp/pest": "^4.0",
        "pestphp/pest-plugin-laravel": "^4.0"
    },
    "autoload": {
        "psr-4": {
            "Edram\\LaravelTempWorkspace\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Edram\\LaravelTempWorkspace\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "post-autoload-dump": "@composer run prepare",
        "prepare": "@php vendor/bin/testbench package:discover --ansi",
        "analyse": "vendor/bin/phpstan analyse --memory-limit=1G",
        "format": "vendor/bin/pint",
        "test": "vendor/bin/pest"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "phpstan/extension-installer": true
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Edram\\LaravelTempWorkspace\\LaravelTempWorkspaceServiceProvider"
            ],
            "aliases": {
                "LaravelTempWorkspace": "Edram\\LaravelTempWorkspace\\Facades\\LaravelTempWorkspace"
            }
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
